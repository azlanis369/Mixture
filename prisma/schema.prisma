// Skema database untuk Sistem Pengurusan Tadika (Mixture)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Cawangan tadika (1 HQ + 7 branch)
model Branch {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  phone     String?
  latitude  Float?
  longitude Float?
  radius    Int      @default(150) // radius geofence (meter) untuk punch card
  isHQ      Boolean  @default(false)
  createdAt DateTime @default(now())

  users         User[]
  attendances   Attendance[]
  prospects     Prospect[]
  tasks         Task[]
  announcements Announcement[]
}

// Pengguna: pekerja tadika pelbagai jawatan
// role: SUPER_ADMIN | ADMIN | HEAD_OF_BRANCH | STAFF
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         String   @default("STAFF")
  position     String?  // jawatan: Guru, Pembantu, Admin Cawangan, dll
  avatarUrl    String?
  active       Boolean  @default(true)
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id])
  createdAt    DateTime @default(now())

  attendances      Attendance[]
  leaveRequests    LeaveRequest[]  @relation("Requester")
  approvals        LeaveRequest[]  @relation("Approver")
  tasks            Task[]          @relation("Assignee")
  createdTasks     Task[]          @relation("Creator")
  prospects        Prospect[]      @relation("Handler")
  announcements    Announcement[]
}

// Sistem punch card harian (clock in / clock out) dengan lokasi + gambar
model Attendance {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id])
  date         String   // YYYY-MM-DD (waktu Malaysia)
  clockInAt    DateTime?
  clockInLat   Float?
  clockInLng   Float?
  clockInAddr  String?
  clockInPhoto String?  // data URL gambar bukti
  clockOutAt    DateTime?
  clockOutLat   Float?
  clockOutLng   Float?
  clockOutAddr  String?
  clockOutPhoto String?
  status       String   @default("PRESENT") // PRESENT | LATE | LEAVE
  createdAt    DateTime @default(now())

  @@unique([userId, date])
}

// Permohonan cuti (cuti awal / emergency / tahunan, dll)
model LeaveRequest {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("Requester", fields: [userId], references: [id])
  type       String   // ANNUAL | EMERGENCY | MEDICAL | EARLY_LEAVE | UNPAID
  startDate  String
  endDate    String
  startTime  String?  // untuk cuti awal (keluar awal)
  reason     String
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED
  approverId String?
  approver   User?    @relation("Approver", fields: [approverId], references: [id])
  reviewNote String?
  createdAt  DateTime @default(now())
}

// Tugas pekerja (terutama Head of Branch: outreach, promosi, edukasi)
model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String   @default("GENERAL") // OUTREACH | PROMOTION | EDUCATION | MEETING | TRAINING | GENERAL
  priority    String   @default("MEDIUM")  // LOW | MEDIUM | HIGH
  status      String   @default("TODO")    // TODO | IN_PROGRESS | DONE
  dueDate     String?
  assigneeId  String?
  assignee    User?    @relation("Assignee", fields: [assigneeId], references: [id])
  creatorId   String?
  creator     User?    @relation("Creator", fields: [creatorId], references: [id])
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id])
  createdAt   DateTime @default(now())
  completedAt DateTime?
}

// Prospek ibu bapa (lead) yang diuruskan Head of Branch melalui WhatsApp
model Prospect {
  id            String   @id @default(cuid())
  parentName    String
  phone         String
  childName     String?
  childAge      String?
  source        String   @default("WALK_IN") // WHATSAPP | FACEBOOK | REFERRAL | WALK_IN | OTHER
  status        String   @default("NEW")      // NEW | CONTACTED | VISIT | ENROLLED | LOST
  notes         String?
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id])
  handledById   String?
  handledBy     User?    @relation("Handler", fields: [handledById], references: [id])
  lastContactAt DateTime?
  createdAt     DateTime @default(now())
}

// Pengumuman / notis (Telegram untuk program & mesyuarat, WhatsApp umum)
model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  channel   String   @default("INTERNAL") // TELEGRAM | WHATSAPP | INTERNAL
  category  String   @default("GENERAL")  // PROGRAM | TRAINING | MEETING | NOTICE | GENERAL
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  branchId  String?  // null = semua cawangan
  branch    Branch?  @relation(fields: [branchId], references: [id])
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
}
