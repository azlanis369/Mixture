# Ad pixel tracking — leave blank to skip loading that pixel entirely.
# Fill in once you create the corresponding ad account / GA4 property.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=

# Founding slot counter — number of the 100 founding REN slots already filled.
# Update in Vercel dashboard as new founding REN subscribe, then redeploy.
# Leave blank or set to 0 to show empty progress bar.
NEXT_PUBLIC_FOUNDING_SLOTS_FILLED=

# Billplz Payment Form URL — the hosted checkout page URL.
# Create a Payment Form in Billplz dashboard, copy the URL, paste here.
# Leave blank to fall back to WhatsApp-only CTA.
# Example: https://www.billplz.com/rf/renflow-plus-founding
NEXT_PUBLIC_BILLPLZ_PAYMENT_URL=
